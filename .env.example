MODE=local
# MODE=cpanel khi deploy lên HawkHost

# Master DB (local)
MASTER_DB_HOST=db
MASTER_DB_NAME=master_quanlybanhang
MASTER_DB_USER=root
MASTER_DB_PASS=root

# cPanel (chỉ dùng khi MODE=cpanel)
CPANEL_HOST=
CPANEL_USER=
CPANEL_TOKEN=
CPANEL_DOMAIN=quanlybanhang.shop

# SMTP Gmail (chưa cần điền)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Quản lý bán hàng"

# Owner / Admin panel
OWNER_EMAIL=owner@quanlybanhang.shop
# bcrypt hash cho password "owner123" — đổi khi triển khai thật
OWNER_PASSWORD_HASH="$2y$10$abcdefghijklmnopqrstuvHash.replace.this.with.real.bcrypt.hash."

# Bank info
BANK_NAME="Vietcombank"
BANK_ACCOUNT="0123456789"
BANK_HOLDER="NGUYEN VAN A"

# Base domain
BASE_DOMAIN=quanlybanhang.shop
LOCAL_BASE_DOMAIN=localhost:8080
