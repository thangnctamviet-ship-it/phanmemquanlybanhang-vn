RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Trang chủ → landing
RewriteRule ^$ landing/ [L]

# Cho phép landing, admin-panel, assets, scripts (file thật)
RewriteRule ^landing(/.*)?$ - [L]
RewriteRule ^admin-panel(/.*)?$ - [L]
RewriteRule ^assets(/.*)?$ - [L]
RewriteRule ^downloads(/.*)?$ - [L]
RewriteRule ^manifest\.json$ - [L]
RewriteRule ^sw\.js$ - [L]
RewriteRule ^favicon\.ico$ - [L]
RewriteRule ^robots\.txt$ - [L]

# Sitemap động
RewriteRule ^sitemap\.xml$ landing/sitemap_dynamic.php [L]

# Blog pretty URLs
RewriteRule ^blog/?$ landing/blog/index.php [L]
RewriteRule ^blog/([a-z0-9-]+)/?$ landing/blog/post.php?slug=$1 [L,QSA]

# Pretty URLs cho các trang landing — gọi tắt /register.php, /pricing.php, ...
RewriteRule ^(register|pricing|login|forgot|install|provision)\.php$ landing/$1.php [L,QSA]

# Tất cả route khác → landing
RewriteRule ^ landing/ [L]
